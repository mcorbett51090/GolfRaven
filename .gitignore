# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Expo / React Native
.expo/
.expo-shared/
apps/mobile/android/
apps/mobile/ios/

# Astro (generated types cache — apps/site)
.astro/

# Build-generated per-country map GeoJSON (apps/site/scripts/gen-map-data.mjs —
# same pattern southern-wine-country used for public/data/hub-wineries.json)
apps/site/public/data/map/

# Local stand-in for the §5.2 R2 OG-card object store (apps/site/src/lib/og-store.ts)
apps/site/.og-store/

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Test scratch output (tests write to the OS temp dir; this guards against regressions)
.tmp-test-*

# P0 desk-check run output (evidence belongs in a run dir outside the source tree —
# gate finding S7; tools default there automatically, these patterns are a backstop
# for an explicit --out/--out-dir/--run-dir that still lands inside the repo)
p0-desk-run-*/
x2-evidence/
x4-verify-result/
x2-verdict-result.*
