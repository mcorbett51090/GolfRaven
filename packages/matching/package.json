{
  "name": "@golfraven/matching",
  "private": true,
  "version": "0.0.0",
  "description": "GolfRaven course matching: course identification from a route or fix against polygons (matcherVersion). Placeholder until P1/§7.4 (build plan §3.1 row D).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
