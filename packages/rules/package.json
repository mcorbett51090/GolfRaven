{
  "name": "@golfraven/rules",
  "private": true,
  "version": "0.0.0",
  "description": "GolfRaven scoring/eligibility rules: scorePlay (policyVersion, §4.5), RuleExpr evaluation, completion/marker-roster eligibility, offer-eligibility validation (build plan §3.1 row E).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@golfraven/catalog": "workspace:*",
    "@golfraven/matching": "workspace:*",
    "@noble/hashes": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
