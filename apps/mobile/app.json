{
  "expo": {
    "name": "GolfRaven",
    "slug": "golfraven",
    "scheme": "golfraven",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.golfraven.app",
      "permissions": ["android.permission.health.READ_EXERCISE"],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.golfraven.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "fr-CA"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GolfRaven uses your location only while the app is open, when you tap “I'm here” or “Buying a marker”, to confirm that you are at the course or shop. It never tracks you in the background.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "react-native-health-connect",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "./modules/golfraven-attest/app.plugin.js",
      "./plugins/with-no-location-service.js"
    ],
    "locales": {
      "fr-CA": "./locales/fr-CA.json"
    }
  }
}
