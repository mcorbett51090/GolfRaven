{
  "name": "@golfraven/mobile",
  "private": true,
  "version": "0.0.0",
  "description": "GolfRaven mobile app (Expo/React Native, build plan §3.1 row G, §7). P4.1 app shell (guest browse, signed catalog cache, outbox, EN/FR-CA) and P4.2a (real api client, secure session storage, sign-in, account linking, deletion, export), plus the P0 Android Health Connect reader for check X1.",
  "main": "expo-router/entry",
  "scripts": {
    "build": "echo \"@golfraven/mobile: no EAS build or expo export in CI yet (real store builds are P4.2). typecheck + test are the gates here.\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check:public-env": "node scripts/check-public-env.mjs",
    "export:ios": "node scripts/check-public-env.mjs && node scripts/export-and-scan.mjs --clear --platform ios",
    "export:android": "node scripts/check-public-env.mjs && node scripts/export-and-scan.mjs --clear --platform android",
    "eas-build-pre-install": "node scripts/check-public-env.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@golfraven/catalog": "workspace:*",
    "@golfraven/catalog-tools": "workspace:*",
    "@golfraven/matching": "workspace:*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@supabase/auth-js": "2.65.0",
    "expo": "57.0.24",
    "expo-apple-authentication": "57.0.2",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-image-picker": "17.0.11",
    "expo-linking": "57.0.10",
    "expo-localization": "57.0.2",
    "expo-location": "57.0.19",
    "expo-router": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.21",
    "expo-sqlite": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-health-connect": "4.1.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "expo-build-properties": "57.0.21",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
