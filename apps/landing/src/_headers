# Cloudflare Pages _headers file — served as-is alongside the static page
# (copied to dist/ by scripts/build.mjs). The page loads no third-party
# scripts, fonts, images or frames except ONE deliberate exception:
# https://challenges.cloudflare.com (Cloudflare Turnstile, main.js), loaded
# only once SIGNUP_ENDPOINT + TURNSTILE_SITE_KEY are configured
# (src/config.js) — and nothing else is allow-listed alongside it.
# `connect-src` is left at 'self': apps/signup-worker is deployed
# same-origin under golfraven.<tld>/api/* (see apps/signup-worker/wrangler.toml),
# so the signup POST needs no additional connect-src origin.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; connect-src 'self'; img-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
