{
  "name": "@golfraven/partners",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Staff/operator/admin portal PWA (build plan \u00a73.1 row H). S7a: shell, passkey sign-in, session. Plain TypeScript bundled by esbuild into a static, strict-CSP bundle.",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run && vitest run --config vitest.e2e.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.2",
    "csp_evaluator": "1.1.8",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
