---
/**
 * /claim/ — "claim or correct a listing" (build plan §5.1: SWC's
 * `claim.astro` + `SecureFormScript.astro` → the shared
 * `raven-site-kit/secure-upload` Worker with `siteId: 'golfraven'`; §10 P2
 * scope: "Claim/feedback forms (the verification funnel)"). A utility
 * page: `noindex` + kept out of the sitemap (`emit-indexability.mjs` never
 * admits `/claim/`; `astro.config.mjs`'s sitemap filter is exact-set
 * membership against that file, so a page absent from it is never in the
 * sitemap even without an explicit exclude rule).
 *
 * THREE modes share one form, driven by the SAME `?facility=`/`?trail=`
 * params the placeholder page and every "claim this listing" CTA already
 * link with (`CourseMap.astro`, `RegionDirectory.astro`,
 * `trails/[slug].astro`) — kept exactly, per this task's scope:
 *   - CORRECTION (facility): `?facility=<slug>` — a specific course listing.
 *   - CORRECTION (trail): `?trail=<slug>` — a specific trail's roster/info.
 *   - NEW SUGGESTION: no query — "I know a course that isn't listed".
 *
 * `?facility=`/`?trail=` are validated against `SLUG_PATTERN` below
 * (gate review nit) before ever being used to prefill a hidden field or
 * humanized display text — every real slug this site mints is
 * `^[a-z0-9-]{1,100}$` (see `packages/catalog`'s slug schema); anything
 * else is dropped outright rather than echoed back into the page or the
 * owner email unfiltered.
 *
 * This is a STATIC build (no SSR adapter — `astro.config.mjs` sets no
 * `output`/`adapter`), so `?facility`/`?trail` are NOT present in
 * `Astro.url` at runtime in production (only in `astro dev`). The values
 * below are read best-effort at build (works in dev), then authoritatively
 * re-read client-side from `location.search` by the script below (a plain,
 * Astro-bundled module script — never `is:inline`; see that script's own
 * doc for why), which fills the hidden fields and swaps the copy — same
 * pattern as SWC's `claim.astro`, adapted to this repo's no-inline-script
 * invariant.
 *
 * The form itself is `SecureFormScript`: it POSTs only to the owned
 * secure-upload Worker (`FORMS_CONFIG.workerUrl`). Fields-only, v1 — no
 * file upload. Until the owner provisions real Worker/Turnstile values
 * (`src/config/forms-config.mjs`'s `TODO(owner)` placeholders), its
 * unprovisioned-guard shows a "forms aren't live yet" message and makes no
 * network call — the build still passes either way.
 *
 * **B1 (gate review, blocking): the form is INERT with no JS, or before
 * JS binds, or while unprovisioned.** All of it sits inside a
 * `<fieldset disabled data-form-fieldset>` — see `SecureFormScript.astro`'s
 * own module doc for why a disabled fieldset (not just a disabled submit
 * button) is what makes a native submission structurally impossible. The
 * `<form>` tag carries `method="post"` (re-gate S-b: restored — a POST
 * fallback is safer than a GET one, which would put field values in the
 * URL; see the frontmatter comment just above the `<form>` tag below for
 * the full reasoning).
 *
 * **S-a (re-gate, should-fix): a static, no-JS-required "forms aren't live
 * yet" notice renders above the form whenever `!isFormsConfigured()`** —
 * the disabled fieldset already stops a submission either way, but with JS
 * off (or before it binds) nothing previously EXPLAINED that to a visitor;
 * SecureFormScript's own `<noscript>` only covers the "no JS at all" case,
 * not "JS is on, the fieldset is just disabled and empty of explanation".
 * This is plain server-rendered markup, so it shows with JS on AND off,
 * and doesn't depend on the client script running at all.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SecureFormScript from "../components/SecureFormScript.astro";
import { FORMS_CONFIG, isFormsConfigured } from "../config/forms-config.mjs";
import { loadSiteCatalog } from "../lib/derive";

/** Every real slug this site mints matches this — see this page's own
 * module doc. A `?facility=`/`?trail=` value that doesn't is dropped
 * outright: never prefilled, never echoed into the page or the hidden
 * fields the owner email is built from. */
const SLUG_PATTERN = /^[a-z0-9-]{1,100}$/;

const { usedDemoData } = await loadSiteCatalog();

// Best-effort server read (populated in dev / any SSR context; empty in
// the static production build, where the inline script below takes over).
const rawFacilitySlug = Astro.url.searchParams.get("facility")?.trim() ?? "";
const rawTrailSlug = Astro.url.searchParams.get("trail")?.trim() ?? "";
const facilitySlug = SLUG_PATTERN.test(rawFacilitySlug) ? rawFacilitySlug : "";
const trailSlug = SLUG_PATTERN.test(rawTrailSlug) ? rawTrailSlug : "";

const formsConfigured = isFormsConfigured(FORMS_CONFIG);

const title = "Suggest a correction | GolfRaven";
const description = "Suggest a correction to a course or trail listing, claim it as its operator, or tell us about a course we haven't added yet.";
const SUCCESS_MESSAGE =
  "Thank you — your note is on its way. We review every submission and will update the listing.";
const VERIFYING_MESSAGE = "Verifying…";
const SENDING_MESSAGE = "Sending…";
// No hard-coded email anywhere: FORMS_CONFIG.contactEmail is empty until
// the owner opts in (forms-config.mjs's TODO(owner)). Every message below
// reads correctly either way — no mailto link, no email text anywhere
// while it stays empty.
const UNPROVISIONED_MESSAGE = FORMS_CONFIG.contactEmail
  ? `This form isn't live yet. To reach us, email ${FORMS_CONFIG.contactEmail} and we'll take care of it.`
  : "This form isn't live yet. Please check back soon.";
const GENERIC_ERROR_MESSAGE = FORMS_CONFIG.contactEmail
  ? `Something went wrong. Please email ${FORMS_CONFIG.contactEmail} instead.`
  : "Something went wrong. Please try again later.";
const TURNSTILE_TIMEOUT_MESSAGE =
  "This form's spam check didn't complete — its Turnstile key likely isn't configured for this domain yet. " +
  (FORMS_CONFIG.contactEmail
    ? `Meanwhile, please email ${FORMS_CONFIG.contactEmail} and we'll take care of it.`
    : "Please check back soon.");
---

<BaseLayout
  title={title}
  description={description}
  path="/claim/"
  noindex={true}
  demo={usedDemoData}
  alternates={[{ locale: "fr", path: "/fr/claim/" }]}
>
  <main class="wrap page" id="main-content" tabindex="-1">
    <header class="page__head">
      <p class="eyebrow">Help keep GolfRaven accurate</p>
      {/* Default copy = NEW-SUGGESTION mode; the inline script swaps to
          the facility/trail CORRECTION copy when a slug is present. */}
      <h1
        id="claim-title"
        data-title-new="Suggest a course for GolfRaven"
        data-title-facility="Claim or correct this listing"
        data-title-trail="Tell us about this trail"
      >
        {facilitySlug ? "Claim or correct this listing" : trailSlug ? "Tell us about this trail" : "Suggest a course for GolfRaven"}
      </h1>
      <p
        class="page__lead"
        id="claim-intro"
        data-intro-new="Know a course we haven't mapped yet? Tell us about it and we'll add it — every listing links out to the course's own site or a booking platform."
        data-intro-facility="Spotted something out of date, or run this course? Send us the correction and we'll update the listing."
        data-intro-trail="Spotted something out of date about this trail — a stop, a link, the roster? Let us know."
      >
        {
          facilitySlug
            ? "Spotted something out of date, or run this course? Send us the correction and we'll update the listing."
            : trailSlug
              ? "Spotted something out of date about this trail — a stop, a link, the roster? Let us know."
              : "Know a course we haven't mapped yet? Tell us about it and we'll add it — every listing links out to the course's own site or a booking platform."
        }
      </p>
      {/* Which listing this is about — revealed client-side when a slug is present. */}
      <p class="claim__for" id="claim-for" hidden>
        This is about: <strong id="claim-for-name"></strong>
      </p>
    </header>

    {/* S-a (re-gate, should-fix): static, server-rendered — shows with JS
        on OR off, and needs no client script to appear. See this page's
        own module doc above for why the disabled-fieldset alone (B1)
        wasn't enough: it silently stops a submission but never explained
        why to a visitor whose JS is on but the form is unprovisioned. */}
    {!formsConfigured && (
      <p class="claim__notice" data-unconfigured-notice role="note">
        {UNPROVISIONED_MESSAGE}
      </p>
    )}

    {/*
      B1 (gate review, blocking) / S-b (re-gate, should-fix): `method="post"`
      IS present below — restored per the re-gate: a POST fallback is safer
      than a GET one, which would put every field's value in the URL (and
      thus browser history / server access logs / a Referer header) if a
      submission ever reached the browser's own native fallback path. The
      REAL defense stays the `<fieldset disabled>` below: per the HTML
      spec, every descendant of a disabled fieldset is excluded from ANY
      native submission's data set, on ANY method — so no field VALUES
      ever reach that fallback regardless of which verb it would have
      used. `method="post"` is belt-and-suspenders on top of that, not a
      substitute for it, and it also matches the CSP-allowed
      `form-action 'self'` POST this repo's own gate review already
      accounts for.
    */}
    <form
      class="claim__form"
      method="post"
      data-secure-form
      novalidate
      data-worker-url={FORMS_CONFIG.workerUrl}
      data-site-id={FORMS_CONFIG.siteId}
      data-turnstile-site-key={FORMS_CONFIG.turnstileSiteKey}
      data-contact-email={FORMS_CONFIG.contactEmail}
      data-locale="en"
      data-success-message={SUCCESS_MESSAGE}
      data-unprovisioned-message={UNPROVISIONED_MESSAGE}
      data-generic-error-message={GENERIC_ERROR_MESSAGE}
      data-verifying-message={VERIFYING_MESSAGE}
      data-sending-message={SENDING_MESSAGE}
      data-turnstile-timeout-message={TURNSTILE_TIMEOUT_MESSAGE}
    >
      {/* B1: disabled by default — SecureFormScript.astro's module script
          removes `disabled` ONCE, ONLY when the form is genuinely
          configured. No JS, JS that never binds, or an unprovisioned
          build all leave this exactly as rendered: disabled, forever, for
          this page view. */}
      <fieldset disabled data-form-fieldset>
      {/* request_type distinguishes a correction from a new suggestion in
          the owner email (and the generate_lead analytics event,
          analytics-schema.json's REQUEST_TYPES: correction | new-listing).
          `facility`/`trail` carry the exact (validated) page slug — the
          authoritative id. All three are hidden, filled/confirmed
          client-side. */}
      <input
        type="hidden"
        name="request_type"
        id="request_type"
        value={facilitySlug || trailSlug ? "correction" : "new-listing"}
      />
      <input type="hidden" name="facility" id="facility" value={facilitySlug} />
      <input type="hidden" name="trail" id="trail" value={trailSlug} />

      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" maxlength="120" required />
      </div>

      <div class="field">
        <label for="email">Your email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="email-hint"
        />
        <p class="field__hint" id="email-hint">So we can follow up if we have a question.</p>
      </div>

      <div class="field">
        <label for="relationship">Your relationship to this course</label>
        <select id="relationship" name="relationship" required>
          <option value="" disabled selected>Select one…</option>
          <option value="owner">Owner</option>
          <option value="staff">Staff or representative</option>
          <option value="visitor">Golfer / visitor</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div class="field">
        <label
          for="message"
          id="message-label"
          data-label-new="Tell us about the course"
          data-label-fix="What should we correct or add?"
        >
          {facilitySlug || trailSlug ? "What should we correct or add?" : "Tell us about the course"}
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          maxlength="4000"
          required
          aria-describedby="message-hint"></textarea>
        <p
          class="field__hint"
          id="message-hint"
          data-hint-new="Name, town & state, tee times / website, and anything else that helps us list it accurately."
          data-hint-fix="Tell us what's wrong or missing — hours, booking link, tees, or anything else — and we'll fix it."
        >
          {
            facilitySlug || trailSlug
              ? "Tell us what's wrong or missing — hours, booking link, tees, or anything else — and we'll fix it."
              : "Name, town & state, tee times / website, and anything else that helps us list it accurately."
          }
        </p>
      </div>

      <SecureFormScript
        workerUrl={FORMS_CONFIG.workerUrl}
        siteId={FORMS_CONFIG.siteId}
        turnstileSiteKey={FORMS_CONFIG.turnstileSiteKey}
        contactEmail={FORMS_CONFIG.contactEmail}
      />

      <button class="btn btn--primary" type="submit">Send it in</button>
      </fieldset>

      {/* S-a (re-gate, should-fix): this claim ("goes directly to our own
          secure form service ... reaches us by email") is only TRUE once
          the form is actually configured — while unconfigured, no
          submission goes anywhere, so the sentence is dropped rather than
          left describing a service that isn't live. The "email us
          directly" invitation below is independent of that (it's about
          `contactEmail`, not about whether the Worker is wired up) and
          still shows whenever an address has been published. */}
      {(formsConfigured || FORMS_CONFIG.contactEmail) && (
        <p class="claim__fineprint">
          {formsConfigured && (
            <>Your message goes directly to our own secure form service (not a third-party form provider) and reaches us by email.{" "}</>
          )}
          {FORMS_CONFIG.contactEmail && (
            <>
              Prefer to write to us yourself? Email{" "}
              <a href={`mailto:${FORMS_CONFIG.contactEmail}`}>{FORMS_CONFIG.contactEmail}</a>.
            </>
          )}
        </p>
      )}
    </form>
  </main>
</BaseLayout>

{/* Runtime hydration of the ?facility/?trail params (static build ->
    not reliably in Astro.url at request time). A plain (non-`is:inline`)
    module script -- this repo's own whole-site invariant
    (`test/acceptance.test.ts`'s AT(7)) forbids ANY inline script content
    anywhere but a single JSON-LD block, so this is bundled into an
    external, same-origin file like every other client script here
    (SiteSearch.astro, CourseMap.astro, SecureFormScript.astro's own
    handler) -- Astro defers a module script's execution until after the
    DOM is parsed, so there is a brief flash of the default copy before
    this swaps it for the facility/trail-specific copy on a
    `?facility=`/`?trail=` arrival; that tradeoff is inherent to this
    site's CSP (`script-src 'self'`, no `'unsafe-inline'`) and is the same
    one every other script on this site already accepts. Purely
    progressive either way: with JS off, SecureFormScript's <noscript>
    fallback covers the whole form, copy-swap included — this page just
    shows its NEW-SUGGESTION default copy regardless of a ?facility/?trail
    param in that case, which is honest (a visitor with no JS can still
    read and understand the page) rather than broken. */}
<script>
  (function () {
    // Gate review nit: only a slug matching this exact shape is ever
    // used — mirrors this page's own server-side SLUG_PATTERN
    // (`^[a-z0-9-]{1,100}$`), so a malformed/oversized/injected
    // `?facility=`/`?trail=` value is dropped here too, not just at
    // build time (this script is what runs in the actual static
    // production build, where the server-side read above is empty).
    var SLUG_RE = /^[a-z0-9-]{1,100}$/;

    var facility = "";
    var trail = "";
    try {
      var params = new URLSearchParams(window.location.search);
      var rawFacility = (params.get("facility") || "").trim();
      var rawTrail = (params.get("trail") || "").trim();
      facility = SLUG_RE.test(rawFacility) ? rawFacility : "";
      trail = SLUG_RE.test(rawTrail) ? rawTrail : "";
    } catch (e) {
      facility = "";
      trail = "";
    }

    var titleEl = document.getElementById("claim-title");
    var introEl = document.getElementById("claim-intro");
    var labelEl = document.getElementById("message-label");
    var hintEl = document.getElementById("message-hint");
    var forEl = document.getElementById("claim-for");
    var forNameEl = document.getElementById("claim-for-name");
    var facilityEl = document.getElementById("facility") as HTMLInputElement | null;
    var trailEl = document.getElementById("trail") as HTMLInputElement | null;
    var typeEl = document.getElementById("request_type") as HTMLInputElement | null;

    function apply(el: HTMLElement | null, attr: string) {
      if (el && el.getAttribute(attr)) el.textContent = el.getAttribute(attr);
    }

    function humanize(slug: string): string {
      return slug
        .replace(/-/g, " ")
        .replace(/\b\w/g, function (c) {
          return c.toUpperCase();
        });
    }

    if (facility) {
      if (facilityEl) facilityEl.value = facility;
      if (typeEl) typeEl.value = "correction";
      apply(titleEl, "data-title-facility");
      apply(introEl, "data-intro-facility");
      apply(labelEl, "data-label-fix");
      apply(hintEl, "data-hint-fix");
      if (forNameEl) forNameEl.textContent = humanize(facility);
      if (forEl) forEl.hidden = false;
    } else if (trail) {
      if (trailEl) trailEl.value = trail;
      if (typeEl) typeEl.value = "correction";
      apply(titleEl, "data-title-trail");
      apply(introEl, "data-intro-trail");
      apply(labelEl, "data-label-fix");
      apply(hintEl, "data-hint-fix");
      if (forNameEl) forNameEl.textContent = humanize(trail) + " trail";
      if (forEl) forEl.hidden = false;
    } else {
      if (typeEl) typeEl.value = "new-listing";
      apply(titleEl, "data-title-new");
      apply(introEl, "data-intro-new");
      apply(labelEl, "data-label-new");
      apply(hintEl, "data-hint-new");
    }
  })();
</script>

<style>
  .page {
    max-width: 46rem;
  }
  .page__head {
    margin-bottom: 1.5rem;
  }
  .page__lead {
    color: var(--ink-soft);
  }
  .claim__for {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-left: 3px solid var(--accent);
    border-radius: 0.3rem;
    padding: 0.55em 0.85em;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .claim__for strong {
    color: var(--ink);
  }

  /* S-a (re-gate, should-fix): the static "forms aren't live yet" notice —
     same visual language as SecureFormScript's own `.form-status[data-kind="info"]`
     so an unconfigured build reads consistently whether the message came
     from static markup (this) or the client script. */
  .claim__notice {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    padding: 0.65em 0.85em;
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--accent) 12%, var(--paper));
    color: var(--ink);
    border-left: 3px solid var(--accent);
  }

  .claim__form {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* Neutralise the browser default <fieldset> box (border/padding/margin)
     and let its children participate directly in .claim__form's own flex
     layout, exactly as if this element weren't there at all — B1's
     disabled-by-default fieldset is a behavioural wrapper, not a visual
     one. */
  fieldset[data-form-fieldset] {
    border: 0;
    margin: 0;
    padding: 0;
    display: contents;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field label {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    font-weight: 600;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
    padding: 0.65em 0.8em;
    width: 100%;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .field__hint {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .btn {
    align-self: flex-start;
    border: none;
    border-radius: 0.4rem;
    padding: 0.65em 1.4em;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .btn--primary {
    background: var(--accent);
    color: #fff;
  }
  .btn--primary[aria-disabled="true"] {
    opacity: 0.6;
    cursor: progress;
  }
  .btn--primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .claim__fineprint {
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .claim__fineprint a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
