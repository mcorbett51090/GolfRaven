---
// Adapted from southern-wine-country's `src/pages/states/[state].astro`
// @ 572ff7e (build plan §5.1 `states/*` → `[country]/[region]/index.astro`).
// Page 1 of a region's directory; page 2+ lives at `page/[n].astro`
// (shared render: `../../../components/RegionDirectory.astro`).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RegionDirectory from "../../../components/RegionDirectory.astro";
import { isIndexable } from "@golfraven/catalog";
import { loadSiteCatalog, regionCodesInUse, regionInfo, regionPages } from "../../../lib/derive";
import { siteOrigin, breadcrumbNode, collectionNode, regionUrl } from "../../../lib/schema";

export async function getStaticPaths() {
  const { catalog } = await loadSiteCatalog();
  return regionCodesInUse(catalog).map((code) => {
    const info = regionInfo(catalog, code);
    const pages = regionPages(catalog, code);
    return {
      params: { country: info.country, region: info.slug },
      props: { code, facilities: pages[0] ?? [], totalPages: pages.length },
    };
  });
}

const { code, facilities, totalPages } = Astro.props;
const { catalog, usedDemoData } = await loadSiteCatalog();
const info = regionInfo(catalog, code);
const totalCount = catalog.facilities.filter((f) => f.region === code).length;

const origin = siteOrigin(Astro.site, import.meta.env.BASE_URL);
const url = regionUrl(origin, info.country, info.slug);
const path = `/${info.country}/${info.slug}/`;
const title = `${info.name} Golf Courses — ${totalCount} to explore | GolfRaven`;
const description = `Every golf course GolfRaven has found in ${info.name} — ${totalCount} in all — mapped and linked.`;
// S1: the ItemList lists only facilities that actually have a page worth
// indexing (the R1-indexable subset), not every row on this page.
const jsonLd = [
  breadcrumbNode([
    { name: "GolfRaven", url: `${origin}/` },
    { name: info.name, url },
  ]),
  collectionNode(
    origin,
    `${info.name} Golf Courses`,
    description,
    facilities.filter((f) => isIndexable(f)),
    url,
  ),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} demo={usedDemoData}>
  <main class="wrap" id="main-content" tabindex="-1">
    <header>
      <p class="eyebrow">Region</p>
      <h1>{info.name}</h1>
    </header>
    <RegionDirectory region={info} facilities={facilities} pageNumber={1} totalPages={totalPages} totalCount={totalCount} />
  </main>
</BaseLayout>
